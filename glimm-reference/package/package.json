{
  "name": "glimm",
  "version": "0.4.1",
  "description": "WebGL sweep transitions for the web — framework-agnostic core with React and Next.js adapters.",
  "keywords": [
    "webgl",
    "shader",
    "page-transition",
    "animation",
    "react",
    "nextjs",
    "oklch"
  ],
  "license": "MIT",
  "author": "Noman Ijaz <noman.ijaz021@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test && npm run typecheck && npm run clean && npm run build",
    "test": "vitest run",
    "test:browser": "node tests/browser/check.mjs",
    "test:slow": "node tests/browser/slow-check.mjs",
    "test:native": "node tests/browser/native.mjs",
    "test:scope": "node tests/browser/scope.mjs",
    "test:ux": "node tests/browser/ux.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.1.3",
    "next": "^16.0.0",
    "playwright-core": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://glimm.dev",
  "bugs": {
    "url": "https://github.com/nomanjack/glimm-skill/issues"
  }
}
